{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipper",
  "version": "1.0.0",
  "identifier": "com.clipper.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipper",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "shadow": true,
        "windowEffects": {
          "effects": ["mica", "acrylic"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost http://localhost:* https://localhost:*"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Clipper — gestionnaire de presse-papiers"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Clipper",
    "shortDescription": "Gestionnaire de presse-papiers moderne",
    "longDescription": "Clipper — Un gestionnaire de presse-papiers puissant avec historique permanent, recherche plein texte, catégories, coloration syntaxique et IA locale.",
    "windows": {
      "wix": {
        "language": ["en-US", "fr-FR"]
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "French"],
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    }
  }
}
